name = "dtt03/s10_bridges"

version = "0.1.0"

license = "Apache-2.0"

keywords = [ "kan-extension", "sheaf", "morita", "operad", "galois-connection" ]

description = "Bridge module S10: combines S1, S3, S4, S5, S6, S8, S9 and the round-one kernel H3 through combination patterns — Kan extensions along subgroup inclusions, sheaf gluing of flat sections, Morita invariance of the centre, Eckmann–Hilton via little cubes, the De Morgan negation as a Galois connection, and the Boolean quotient of the free De Morgan algebra certified by the symbolic prover"

import {
  "dtt03/s1_de_morgan_cubes@0.1.0",
  "dtt03/s2_cubical_paths@0.1.0",
  "dtt03/s3_weak_omega_groupoid@0.1.0",
  "dtt03/s4_rewriting_cover@0.1.0",
  "dtt03/s5_connection_curvature@0.1.0",
  "dtt03/s6_deformation_derived@0.1.0",
  "dtt03/s7_adjoint_logic@0.1.0",
  "dtt03/s8_symbolic_nbe@0.1.0",
  "dtt03/s9_little_cubes@0.1.0",
  "dtt03/h3_nbe_typecheck@0.1.0",
}
