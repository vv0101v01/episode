name = "dtt03/h3_nbe_typecheck"

version = "0.1.0"

license = "Apache-2.0"

keywords = [
  "normalization-by-evaluation",
  "type-checking",
  "proofs-as-programs",
  "call-by-need",
  "bidirectional",
]

description = "Independent module H3: call-by-need normalization by evaluation with type-directed eta-long readback, typed and untyped conversion, derivation-producing kernel type checker with cumulative subtyping, bidirectional surface elaboration, and proofs-as-programs extraction onto a lazy abstract machine"
