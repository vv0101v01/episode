name = "dtt03/s5_connection_curvature"

version = "0.1.0"

license = "Apache-2.0"

keywords = [
  "connection",
  "curvature",
  "holonomy",
  "horizontal-distribution",
  "groupoid-model",
]

description = "Module S5 (uses S4): discrete connections on bundles over 2-complexes — parallel transport, horizontal distributions (Ehresmann), curvature as face holonomy, gauge transformations, non-abelian Stokes, Ambrose-Singer, flat connections as type families over the fundamental groupoid (Hofmann-Streicher groupoid model), total spaces by the Grothendieck construction, and the based-path family as the universal cover"

import {
  "dtt03/s4_rewriting_cover@0.1.0",
}
