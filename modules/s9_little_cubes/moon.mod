name = "dtt03/s9_little_cubes"

version = "0.1.0"

license = "Apache-2.0"

keywords = [
  "little-cubes",
  "operad",
  "configuration-space",
  "eckmann-hilton",
  "braid",
]

description = "Independent module S9: the little n-cubes operad with exact rational coordinates — partial composition, symmetric action, unit, verified operad axioms, the morphism to the associative operad in dimension one, stabilization E_n to E_{n+1}, the action on loop words, and the homology of discretized two-point configuration spaces (components, first Betti number, braid winding)"
